@model List<ITI.BLL.ViewModel.DonorResponseHistoryVM>
@{
    ViewData["Title"] = "Response History";
}

<style>
    .donor-header {
        background: #0f1420;
        color: #fff;
        padding: 30px 40px;
    }

    .nav-tabs-custom {
        background: #0f1420;
        padding: 0 40px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .nav-tabs-custom a {
        color: #9a9da5;
        text-decoration: none;
        padding: 14px 4px;
        margin-right: 30px;
        display: inline-block;
        font-size: 0.9rem;
        border-bottom: 2px solid transparent;
    }

    .nav-tabs-custom a.active {
        color: #fff;
        border-bottom-color: #b3122b;
        font-weight: 600;
    }

    .history-container {
        padding: 30px 40px;
        background: #f5f6f8;
        min-height: 60vh;
    }

    .history-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #eaeaea;
    }
</style>

<div class="donor-header">
    <h3 style="font-family:Georgia, serif;">Response History</h3>
    <p style="color:#9a9da5; margin-bottom:0;">Blood requests you've responded to</p>
</div>

<div class="nav-tabs-custom">
    <a asp-action="Dashboard" asp-controller="Donor">Overview</a>
    <a asp-action="Index" asp-controller="DonationRequest">My Requests</a>
    <a asp-action="History" asp-controller="Donor" class="active">History</a>
    <a asp-action="Appointments" asp-controller="Donor">Appointments</a>
</div>

<div class="history-container">
    <div class="history-card">
        @if (Model == null || Model.Count == 0)
        {
            <div class="text-center py-5">
                <div style="font-size:2rem;">🩸</div>
                <h5 class="fw-bold mt-2">No responses yet</h5>
                <p class="text-muted small">You haven't responded to any blood requests yet.</p>
                <a asp-controller="BloodRequest" asp-action="Index" class="btn"
                   style="background:#b3122b;color:#fff;font-weight:600;border-radius:8px;padding:8px 18px;">
                    Browse Active Requests
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Hospital</th>
                            <th>City</th>
                            <th>Blood Type</th>
                            <th>Units</th>
                            <th>Urgency</th>
                            <th>Request Status</th>
                            <th class="pe-4">Your Response</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.HospitalName</td>
                                <td>📍 @item.City</td>
                                <td>
                                    <span class="badge rounded-pill" style="background:rgba(179,18,43,.1); color:#b3122b;">
                                        @item.BloodType
                                    </span>
                                </td>
                                <td>@item.UnitsRequired</td>
                                <td>
                                    <span class="badge rounded-pill @(item.Urgency == "Emergency" ? "bg-danger-subtle text-danger-emphasis" : "bg-warning-subtle text-warning-emphasis")">
                                        @item.Urgency
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(item.RequestStatus == "Fulfilled" ? "bg-success-subtle text-success-emphasis" : "bg-primary-subtle text-primary-emphasis")">
                                        @item.RequestStatus
                                    </span>
                                </td>
                                <td class="pe-4">
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">
                                        @item.ResponseStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
