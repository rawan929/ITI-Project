@model ITI.BLL.ViewModel.HospitalProfileVM

@{
    Layout = "_Layout";
    ViewData["Title"] = "Hospital Profile";
}

<style>
    .hosp-page { --brand-red:#b3122b; --brand-red-dark:#8f0e22; --dark-navy:#0f1420; font-family:'Segoe UI', Tahoma, sans-serif; }
    .hosp-page .btn-brand { background:var(--brand-red); border-color:var(--brand-red); color:#fff; font-weight:700; }
    .hosp-page .btn-brand:hover { background:var(--brand-red-dark); border-color:var(--brand-red-dark); color:#fff; }
    .hosp-page .card { border-radius:12px; border:1px solid #e5e7eb; }
    .hosp-page .icon-circle { width:56px; height:56px; border-radius:16px; display:flex; align-items:center; justify-content:center; }
    .hosp-page .hosp-header { background:var(--dark-navy); color:#fff; margin:-1rem -1rem 2rem -1rem; padding:2rem 1.5rem 0; }
    .hosp-page .hosp-nav-link { color:rgba(255,255,255,.6); text-decoration:none; font-size:.9rem; padding-bottom:1rem; display:inline-block; }
    .hosp-page .hosp-nav-link.active { color:#fff; font-weight:600; border-bottom:2px solid #fff; }
</style>

<div class="hosp-page">

    <div class="hosp-header">
        <div class="container-fluid" style="max-width:1200px;">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="icon-circle" style="background:var(--brand-red);">
                    <span style="font-size:1.4rem;">🏥</span>
                </div>
                <div>
                    <p class="mb-0 small text-white-50">Hospital Services</p>
                    <h1 class="h4 fw-bold mb-0" style="font-family:Georgia, serif;">BloodLink+ Hospital</h1>
                    <p class="mb-0 small text-white-50">Hospital Profile</p>
                </div>
            </div>
            <div class="d-flex gap-4">
                <a asp-action="Dashboard" class="hosp-nav-link">Overview</a>
                <a asp-action="CreateRequest" class="hosp-nav-link">Create Request</a>
                @if ((bool)(ViewBag.IsHospitalApproved ?? false))
                {
                    <a asp-action="Profile" class="hosp-nav-link active">Profile</a>
                }
            </div>
        </div>
    </div>

    <div class="container" style="max-width:700px;">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                ✅ @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <p class="text-uppercase text-muted small fw-bold mb-1">Hospital Information</p>
                        <h2 class="h5 fw-bold mb-0">Edit Profile</h2>
                    </div>
                    @if (Model.IsApproved)
                    {
                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis">✔ Approved</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis">Pending Approval</span>
                    }
                </div>

                <form asp-action="Profile" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="IsApproved" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label text-uppercase small fw-bold text-muted"></label>
                        <input asp-for="Name" class="form-control" placeholder="Hospital name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label text-uppercase small fw-bold text-muted"></label>
                        <input asp-for="Address" class="form-control" placeholder="Street address" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="City" class="form-label text-uppercase small fw-bold text-muted"></label>
                        <input asp-for="City" class="form-control" placeholder="City" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Phone" class="form-label text-uppercase small fw-bold text-muted"></label>
                        <input asp-for="Phone" class="form-control" placeholder="Phone number" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-brand">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}