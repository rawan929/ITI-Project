@model List<ITI.BLL.ViewModel.DonorResponseViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Donor Responses";
}

<style>
    .hosp-page { --brand-red:#b3122b; --brand-red-dark:#8f0e22; --dark-navy:#0f1420; font-family:'Segoe UI', Tahoma, sans-serif; }
    .hosp-page .card { border-radius:12px; border:1px solid #e5e7eb; }
    .hosp-page .icon-circle { width:56px; height:56px; border-radius:16px; display:flex; align-items:center; justify-content:center; }
    .hosp-page .avatar-circle { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; background:rgba(179,18,43,.08); color:var(--brand-red); font-weight:700; font-size:.85rem; }
    .hosp-page .hosp-header { background:var(--dark-navy); color:#fff; margin:-1rem -1rem 2rem -1rem; padding:2rem 1.5rem 0; }
    .hosp-page .hosp-nav-link { color:rgba(255,255,255,.6); text-decoration:none; font-size:.9rem; padding-bottom:1rem; display:inline-block; }
</style>

<div class="hosp-page">

    <div class="hosp-header">
        <div class="container-fluid" style="max-width:1200px;">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="icon-circle" style="background:var(--brand-red);">
                    <span style="font-size:1.4rem;">👥</span>
                </div>
                <div>
                    <p class="mb-0 small text-white-50">Hospital Services</p>
                    <h1 class="h4 fw-bold mb-0" style="font-family:Georgia, serif;">BloodLink+ Hospital</h1>
                    <p class="mb-0 small text-white-50">Donor Responses</p>
                </div>
            </div>
            <div class="d-flex gap-4">
                <a asp-action="Dashboard" class="hosp-nav-link">Overview</a>
                <a asp-action="CreateRequest" class="hosp-nav-link">Create Request</a>

                @if ((bool)(ViewBag.IsHospitalApproved ?? false))
                {
                    <a asp-action="Profile" class="hosp-nav-link">Profile</a>
                }
            </div>
        </div>
    </div>

    <div class="container-fluid" style="max-width:1200px;">
        <div class="card">
            <div class="card-body p-4">
                <p class="text-uppercase text-muted small fw-bold mb-1">Blood Request</p>
                <h2 class="h5 fw-bold mb-1">Donor Responses</h2>
                <p class="text-muted small mb-4">Donors invited for this request, and how they answered.</p>

                @if (Model == null || Model.Count == 0)
                {
                    <div class="text-center py-5">
                        <div class="icon-circle bg-light mx-auto mb-3">👥</div>
                        <h5 class="fw-bold">No Donor Responses</h5>
                        <p class="text-muted small">No donors have responded to this request yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr class="text-uppercase text-muted small">
                                    <th>Donor</th>
                                    <th>Blood Type</th>
                                    <th>City</th>
                                    <th>Phone</th>
                                    <th>Donations</th>
                                    <th>Response</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var donor in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="avatar-circle">@donor.Initials</div>
                                                <div>
                                                    <div class="fw-bold small">@donor.FullName</div>
                                                    <div class="text-muted" style="font-size:.75rem;">Donor</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge rounded-pill" style="background:rgba(179,18,43,.1); color:var(--brand-red);">@donor.BloodType</span></td>
                                        <td>📍 @donor.City</td>
                                        <td>📞 @(string.IsNullOrWhiteSpace(donor.PhoneNumber) ? "—" : donor.PhoneNumber)</td>
                                        <td>@donor.TotalDonations</td>
                                        <td>
                                            @switch (donor.ResponseStatus)
                                            {
                                                case "Accepted":
                                                    <span class="badge rounded-pill bg-success bg-opacity-25 text-success-emphasis">✔ Accepted</span>
                                                    break;
                                                case "Declined":
                                                    <span class="badge rounded-pill bg-light text-muted">Declined</span>
                                                    break;
                                                default:
                                                    <span class="badge rounded-pill bg-primary bg-opacity-25 text-primary-emphasis">Invited</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @if (donor.IsActive)
                                            {
                                                <span class="badge rounded-pill bg-success bg-opacity-25 text-success-emphasis">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-light text-muted">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Dashboard" class="text-decoration-none small fw-semibold">← Back to Dashboard</a>
        </div>
    </div>
</div>