<style>
    .bank-page { --brand-red:#b3122b; --brand-red-dark:#8f0e22; --dark-navy:#0f1420; font-family:'Segoe UI', Tahoma, sans-serif; }
    .bank-page .btn-brand { background:var(--brand-red); border-color:var(--brand-red); color:#fff; font-weight:700; }
    .bank-page .btn-brand:hover { background:var(--brand-red-dark); border-color:var(--brand-red-dark); color:#fff; }
    .bank-page .card { border-radius:12px; border:1px solid #e5e7eb; }
    .bank-page .icon-circle { width:56px; height:56px; border-radius:16px; display:flex; align-items:center; justify-content:center; }
    .bank-page .stat-icon { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; }
    .bank-page .bank-header { background:var(--dark-navy); color:#fff; margin:-1rem -1rem 2rem -1rem; padding:2rem 1.5rem 0; }
    .bank-page .bank-nav-link { color:rgba(255,255,255,.6); text-decoration:none; font-size:.9rem; padding-bottom:1rem; display:inline-block; }
    .bank-page .bank-nav-link.active { color:#fff; font-weight:600; border-bottom:2px solid #fff; }
    .bank-page .blood-chip { width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-weight:700; background:rgba(179,18,43,.08); color:var(--brand-red); }
    .bank-page .stock-bar { height:6px; border-radius:99px; background:#eef0f3; overflow:hidden; }
    .bank-page .stock-bar > span { display:block; height:100%; border-radius:99px; background:var(--brand-red); }
</style>

@{
    var active = ViewData["ActiveTab"] as string ?? "Overview";
    var isApproved = (bool)(ViewBag.IsBloodBankApproved ?? false);
    var bankName = ViewBag.BloodBankName as string ?? "Blood Bank";

    string Tab(string name) => active == name ? "bank-nav-link active" : "bank-nav-link";
}

<div class="bank-header">
    <div class="container-fluid" style="max-width:1200px;">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-circle" style="background:var(--brand-red);">
                    <span style="font-size:1.4rem;">🏦</span>
                </div>
                <div>
                    <p class="mb-0 small text-white-50">Blood Bank Services</p>
                    <h1 class="h4 fw-bold mb-0" style="font-family:Georgia, serif;">@bankName</h1>
                    <p class="mb-0 small text-white-50">Blood Bank Dashboard</p>
                </div>
            </div>

            @if (isApproved)
            {
                <span class="badge rounded-pill border text-success px-3 py-2">
                    <span class="d-inline-block rounded-circle bg-success" style="width:8px;height:8px;"></span>
                    Approved
                </span>
            }
            else
            {
                <span class="badge rounded-pill border text-warning px-3 py-2">
                    <span class="d-inline-block rounded-circle bg-warning" style="width:8px;height:8px;"></span>
                    Pending Approval
                </span>
            }
        </div>

        <div class="d-flex gap-4 flex-wrap">
            <a asp-action="Dashboard" class="@Tab("Overview")">Overview</a>
            <a asp-action="Inventory" class="@Tab("Inventory")">Inventory</a>
            <a asp-action="RecordDonation" class="@Tab("RecordDonation")">Record Donation</a>
            <a asp-action="Donations" class="@Tab("Donations")">Donations</a>
            <a asp-action="Appointments" class="@Tab("Appointments")">Appointments</a>
            <a asp-action="Requests" class="@Tab("Requests")">Hospital Requests</a>
            @if (isApproved)
            {
                <a asp-action="Profile" class="@Tab("Profile")">Profile</a>
            }
        </div>
    </div>
</div>

<div class="container-fluid" style="max-width:1200px;">
    @if (!isApproved)
    {
        <div class="alert alert-warning border-0 rounded-3 small">
            <strong>Your blood bank is waiting for admin approval.</strong>
            You can look around, but recording donations, changing stock and fulfilling
            hospital requests stay locked until an admin approves your account.
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 small">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 small">@TempData["ErrorMessage"]</div>
    }
</div>
