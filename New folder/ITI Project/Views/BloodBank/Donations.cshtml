@model List<ITI.BLL.ViewModel.BloodBankDonationVM>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Donations";
    ViewData["ActiveTab"] = "Donations";

    var totalUnits = Model.Sum(d => d.Units);
}

<div class="bank-page">

    @await Html.PartialAsync("_BankHeader")

    <div class="container-fluid" style="max-width:1200px;">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                    <div>
                        <p class="text-uppercase text-muted small fw-bold mb-1">Donation History</p>
                        <h2 class="h5 fw-bold mb-1">All Donations</h2>
                        <p class="text-muted small mb-0">
                            @Model.Count donations · @totalUnits units collected in total.
                        </p>
                    </div>
                    <a asp-action="RecordDonation" class="btn btn-brand">+ Record Donation</a>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <div class="icon-circle bg-light mx-auto mb-3">🩸</div>
                        <h5 class="fw-bold">No Donations Yet</h5>
                        <p class="text-muted small">Nothing has been collected at this blood bank so far.</p>
                        <a asp-action="RecordDonation" class="btn btn-brand mt-2">+ Record Your First Donation</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr class="text-uppercase text-muted small">
                                    <th>Donor</th>
                                    <th>Blood Type</th>
                                    <th>Units</th>
                                    <th>Date</th>
                                    <th class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var donation in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@donation.DonorName</td>
                                        <td><span class="fw-bold">🩸 @donation.BloodTypeName</span></td>
                                        <td>@donation.Units <span class="text-muted small">units</span></td>
                                        <td>@donation.DonationDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">
                                            @if (donation.Status == "Completed")
                                            {
                                                <span class="badge rounded-pill bg-success bg-opacity-25 text-success-emphasis">✔ Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-light text-dark">@donation.Status</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
