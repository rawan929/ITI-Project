@model ITI.BLL.ViewModel.BloodBankProfileVM

@{
    Layout = "_Layout";
    ViewData["Title"] = "Blood Bank Profile";
    ViewData["ActiveTab"] = "Profile";
}

<div class="bank-page">

    @await Html.PartialAsync("_BankHeader")

    <div class="container-fluid" style="max-width:1200px;">
        <div class="row g-3">
            <div class="col-12 col-lg-7">
                <div class="card">
                    <div class="card-body p-4">
                        <p class="text-uppercase text-muted small fw-bold mb-1">Account</p>
                        <h2 class="h5 fw-bold mb-1">Blood Bank Details</h2>
                        <p class="text-muted small mb-4">
                            Your city decides which donors and which hospital requests you see,
                            so keep it accurate.
                        </p>

                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <form asp-action="Profile" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label small fw-semibold"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Address" class="form-label small fw-semibold"></label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="City" class="form-label small fw-semibold"></label>
                                    <input asp-for="City" class="form-control" />
                                    <span asp-validation-for="City" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label small fw-semibold"></label>
                                    <input asp-for="Phone" class="form-control" />
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-brand">Save Changes</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <p class="text-uppercase text-muted small fw-bold mb-1">Status</p>
                        <h2 class="h5 fw-bold mb-3">Account Status</h2>

                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Email</span>
                            <span class="small fw-semibold">@Model.Email</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Approval</span>
                            @if (Model.IsApproved)
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-25 text-success-emphasis">Approved</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning-emphasis">Pending</span>
                            }
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted small">City</span>
                            <span class="small fw-semibold">@Model.City</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
