@model ITI.BLL.ViewModel.BloodBankInventoryPageVM

@{
    Layout = "_Layout";
    ViewData["Title"] = "Inventory";
    ViewData["ActiveTab"] = "Inventory";

    var isApproved = (bool)(ViewBag.IsBloodBankApproved ?? false);
}

<div class="bank-page">

    @await Html.PartialAsync("_BankHeader")

    <div class="container-fluid" style="max-width:1200px;">
        <div class="row g-3">

            <!-- Stock table -->
            <div class="col-12 col-lg-7">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <p class="text-uppercase text-muted small fw-bold mb-1">Current Stock</p>
                        <h2 class="h5 fw-bold mb-1">Blood Inventory</h2>
                        <p class="text-muted small mb-4">
                            Every blood type is listed, including the ones you have none of.
                        </p>

                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="text-uppercase text-muted small">
                                        <th>Blood Type</th>
                                        <th>Units Available</th>
                                        <th class="text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="blood-chip" style="width:38px;height:38px;font-size:.8rem;">@item.BloodTypeName</div>
                                                    <span class="fw-bold">@item.BloodTypeName</span>
                                                </div>
                                            </td>
                                            <td>@item.UnitsAvailable <span class="text-muted small">units</span></td>
                                            <td class="text-end">
                                                @if (item.IsOutOfStock)
                                                {
                                                    <span class="badge rounded-pill" style="background:rgba(179,18,43,.1); color:var(--brand-red);">Out of stock</span>
                                                }
                                                else if (item.IsLowStock)
                                                {
                                                    <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning-emphasis">Low</span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill bg-success bg-opacity-25 text-success-emphasis">Healthy</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Adjust form -->
            <div class="col-12 col-lg-5">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <p class="text-uppercase text-muted small fw-bold mb-1">Stock Control</p>
                        <h2 class="h5 fw-bold mb-1">Add or Remove Units</h2>
                        <p class="text-muted small mb-4">
                            Use this for stock that doesn't come from a recorded donation —
                            transfers in, expired bags, or manual corrections.
                        </p>

                        <form asp-action="AdjustInventory" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Blood Type</label>
                                <select name="BloodTypeId" class="form-select" required>
                                    <option value="">Choose a blood type</option>
                                    @foreach (var type in Model.Adjust.AvailableBloodTypes)
                                    {
                                        <option value="@type.Id">@type.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Units</label>
                                <input type="number" name="Units" class="form-control" min="1" max="500" value="1" required />
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-semibold">Operation</label>
                                <select name="Operation" class="form-select">
                                    <option value="Add">Add to stock</option>
                                    <option value="Remove">Remove from stock</option>
                                </select>
                            </div>

                            <button type="submit" class="btn btn-brand w-100" disabled="@(!isApproved)">
                                Update Inventory
                            </button>

                            @if (!isApproved)
                            {
                                <p class="text-muted small mt-2 mb-0">
                                    Available once an admin approves your blood bank.
                                </p>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
