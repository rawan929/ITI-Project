@model List<ITI.BLL.ViewModel.BloodBankAppointmentVM>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Appointments";
    ViewData["ActiveTab"] = "Appointments";

    var isApproved = (bool)(ViewBag.IsBloodBankApproved ?? false);
    var upcoming = Model.Count(a => a.IsUpcoming);
}

<div class="bank-page">

    @await Html.PartialAsync("_BankHeader")

    <div class="container-fluid" style="max-width:1200px;">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                    <div>
                        <p class="text-uppercase text-muted small fw-bold mb-1">Scheduling</p>
                        <h2 class="h5 fw-bold mb-1">Donor Appointments</h2>
                        <p class="text-muted small mb-0">@upcoming upcoming · @Model.Count in total.</p>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <div class="icon-circle bg-light mx-auto mb-3">📅</div>
                        <h5 class="fw-bold">No Appointments</h5>
                        <p class="text-muted small mb-0">
                            No donor has booked a slot at this blood bank yet.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr class="text-uppercase text-muted small">
                                    <th>Donor</th>
                                    <th>Blood Type</th>
                                    <th>Phone</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@appointment.DonorName</td>
                                        <td><span class="fw-bold">🩸 @appointment.BloodTypeName</span></td>
                                        <td class="text-muted small">
                                            @(string.IsNullOrWhiteSpace(appointment.Phone) ? "—" : appointment.Phone)
                                        </td>
                                        <td>@appointment.AppointmentDate.ToString("dd MMM yyyy · HH:mm")</td>
                                        <td>
                                            @switch (appointment.Status)
                                            {
                                                case "Completed":
                                                    <span class="badge rounded-pill bg-success bg-opacity-25 text-success-emphasis">✔ Completed</span>
                                                    break;
                                                case "Cancelled":
                                                    <span class="badge rounded-pill" style="background:rgba(179,18,43,.1); color:var(--brand-red);">Cancelled</span>
                                                    break;
                                                case "NoShow":
                                                    <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning-emphasis">No show</span>
                                                    break;
                                                default:
                                                    <span class="badge rounded-pill bg-primary bg-opacity-25 text-primary-emphasis">Scheduled</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (appointment.Status == "Scheduled" && isApproved)
                                            {
                                                <div class="d-inline-flex gap-2">
                                                    <form asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@appointment.AppointmentId" />
                                                        <input type="hidden" name="status" value="Completed" />
                                                        <button type="submit" class="btn btn-sm btn-outline-success">Completed</button>
                                                    </form>
                                                    <form asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@appointment.AppointmentId" />
                                                        <input type="hidden" name="status" value="NoShow" />
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary">No show</button>
                                                    </form>
                                                    <form asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@appointment.AppointmentId" />
                                                        <input type="hidden" name="status" value="Cancelled" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
