@model IEnumerable<ITI.DAL.Models.BloodRequest>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Blood Requests";

    var respondedIds = (HashSet<Guid>)(ViewBag.RespondedRequestIds ?? new HashSet<Guid>());
}

<style>
    .hosp-page { --brand-red:#b3122b; --brand-red-dark:#8f0e22; --dark-navy:#0f1420; font-family:'Segoe UI', Tahoma, sans-serif; background:#f8f9fa; }
    .hosp-page .btn-brand { background:var(--brand-red); border-color:var(--brand-red); color:#fff; font-weight:700; }
    .hosp-page .btn-brand:hover { background:var(--brand-red-dark); border-color:var(--brand-red-dark); color:#fff; }
    .hosp-page .card { border-radius:12px; }
    .hosp-page .hero { background:var(--dark-navy); color:#fff; margin:-1rem -1rem 0 -1rem; padding:2rem 1.5rem; }
</style>

<div class="hosp-page">
    <div class="hero">
        <div class="container-fluid" style="max-width:1200px;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width:44px;height:44px;background:var(--brand-red);">🩸</div>
                <div>
                    <h1 class="h4 fw-bold mb-0">Emergency Blood Requests</h1>
                    <p class="text-white-50 small mb-0">Find blood requests that need your help</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid py-4" style="max-width:1200px;">

        @if (User.IsInRole("Donor"))
        {
            <a asp-controller="Donor" asp-action="Dashboard" class="btn btn-outline-secondary mb-3">← Back to My Dashboard</a>
        }
        else if (User.IsInRole("Hospital"))
        {
            <a asp-controller="Hospital" asp-action="Dashboard" class="btn btn-outline-secondary mb-3">← Back to My Dashboard</a>
        }

        @if (TempData["ResponseMessage"] != null)
        {
            var isSuccess = TempData["ResponseSuccess"]?.ToString() == "True";
            <div class="alert @(isSuccess ? "alert-success" : "alert-warning") alert-dismissible fade show" role="alert">
                @(isSuccess ? "✅" : "⚠️") @TempData["ResponseMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card p-4 mb-4">
            <h2 class="h6 fw-semibold mb-3">🔍 Filter Requests</h2>
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">City</label>
                    <input type="text" name="city" value="@Context.Request.Query["city"]"
                           class="form-control" placeholder="Enter city" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Blood Type</label>
                    <select name="bloodTypeId" class="form-select">
                        <option value="">All Blood Types</option>
                        @foreach (var bloodType in ViewBag.BloodTypes)
                        {
                            <option value="@bloodType.Id">@bloodType.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-brand w-100">🔍 Search</button>
                </div>
            </form>
        </div>

        <div class="card">
            <div class="card-body p-4">
                <h2 class="h6 fw-semibold mb-1">Available Requests</h2>
                <p class="text-muted small mb-3">Emergency requests that need blood donors</p>

                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Hospital</th>
                                    <th>City</th>
                                    <th>Blood Type</th>
                                    <th>Units</th>
                                    <th>Urgency</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model)
                                {
                                    var alreadyResponded = respondedIds.Contains(request.Id);
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">🏥 @request.Hospital?.Name</div>
                                        </td>
                                        <td>📍 @request.Hospital?.City</td>
                                        <td><span class="badge rounded-pill" style="background:rgba(179,18,43,.1); color:var(--brand-red);">@request.BloodType?.Name</span></td>
                                        <td>@request.UnitsRequired</td>
                                        <td>
                                            <span class="badge rounded-pill @(request.Urgency == "Emergency" ? "bg-danger-subtle text-danger-emphasis" : "bg-warning-subtle text-warning-emphasis")">
                                                @request.Urgency
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill @(request.Status == "Fulfilled" ? "bg-success-subtle text-success-emphasis" : "bg-primary-subtle text-primary-emphasis")">
                                                @request.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            @if (alreadyResponded)
                                            {
                                                <span class="badge rounded-pill bg-success-subtle text-success-emphasis">
                                                    ✔ Already Responded
                                                </span>
                                            }
                                            else
                                            {
                                                <form asp-controller="DonationRequest" asp-action="Respond" method="post" class="d-inline">
                                                    <input type="hidden" name="requestId" value="@request.Id" />
                                                    <button type="submit" class="btn btn-brand btn-sm">🤝 Respond</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="mx-auto mb-3 rounded-circle bg-light d-flex align-items-center justify-content-center" style="width:56px;height:56px;">🩸</div>
                        <h5 class="fw-semibold">No blood requests found</h5>
                        <p class="text-muted small">There are currently no requests matching your search.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>