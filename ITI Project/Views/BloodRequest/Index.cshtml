@model IEnumerable<ITI.DAL.Models.BloodRequest>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Blood Requests";
}

<div class="min-h-screen bg-slate-50">

    <!-- Header -->
    <div class="bg-slate-900 text-white">
        <div class="max-w-7xl mx-auto px-6 py-8">

            <div class="flex items-center gap-3">

                <div class="w-11 h-11 rounded-xl bg-rose-500 flex items-center justify-center">
                    <i class="fa-solid fa-droplet text-xl"></i>
                </div>

                <div>
                    <h1 class="text-2xl font-bold">
                        Emergency Blood Requests
                    </h1>

                    <p class="text-slate-300 text-sm mt-1">
                        Find blood requests that need your help
                    </p>
                </div>

            </div>

        </div>
    </div>


    <div class="max-w-7xl mx-auto px-6 py-8">

        <!-- Filters -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6 mb-6">

            <div class="flex items-center gap-2 mb-5">

                <i class="fa-solid fa-filter text-rose-500"></i>

                <h2 class="text-lg font-semibold text-slate-800">
                    Filter Requests
                </h2>

            </div>


            <form asp-action="Index"
                  method="get"
                  class="grid grid-cols-1 md:grid-cols-3 gap-4">


                <!-- City -->
                <div>

                    <label class="block text-sm font-medium text-slate-700 mb-2">
                        City
                    </label>

                    <input type="text"
                           name="city"
                           value="@Context.Request.Query["city"]"
                           placeholder="Enter city"
                           class="w-full rounded-xl border border-slate-300 px-4 py-2.5
                    focus:outline-none focus:ring-2 focus:ring-rose-400" />

                </div>


                <!-- Blood Type -->
                <div>

                    <label class="block text-sm font-medium text-slate-700 mb-2">
                        Blood Type
                    </label>

                    <select name="bloodTypeId"
                            class="w-full rounded-xl border border-slate-300 px-4 py-2.5
                        focus:outline-none focus:ring-2 focus:ring-rose-400">

                        <option value="">
                            All Blood Types
                        </option>

                        @foreach (var bloodType in ViewBag.BloodTypes)
                        {
                            <option value="@bloodType.Id">
                                @bloodType.Name
                            </option>
                        }

                    </select>

                </div>


                <!-- Search -->
                <div class="flex items-end">

                    <button type="submit"
                            class="w-full bg-rose-500 hover:bg-rose-600
                        text-white font-medium rounded-xl
                        px-5 py-2.5 transition">

                        <i class="fa-solid fa-magnifying-glass mr-2"></i>

                        Search

                    </button>

                </div>

            </form>

        </div>


        <!-- Requests -->
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">

            <div class="px-6 py-5 border-b border-slate-200">

                <h2 class="text-lg font-semibold text-slate-800">
                    Available Requests
                </h2>

                <p class="text-sm text-slate-500 mt-1">
                    Emergency requests that need blood donors
                </p>

            </div>


            @if (Model != null && Model.Any())
            {
                <div class="overflow-x-auto">

                    <table class="w-full">

                        <thead class="bg-slate-50">

                            <tr>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-slate-600">
                                    Blood Type
                                </th>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-slate-600">
                                    Units
                                </th>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-slate-600">
                                    Urgency
                                </th>

                                <th class="text-left px-6 py-4 text-sm font-semibold text-slate-600">
                                    Status
                                </th>

                                <th class="text-right px-6 py-4 text-sm font-semibold text-slate-600">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody class="divide-y divide-slate-100">

                            @foreach (var request in Model)
                            {
                                <tr class="hover:bg-slate-50 transition">

                                    <!-- Blood Type -->
                                    <td class="px-6 py-4">

                                        <span class="inline-flex items-center justify-center
                                            min-w-12 px-3 py-2 rounded-lg
                                            bg-rose-50 text-rose-600 font-bold">

                                            @request.BloodType?.Name

                                        </span>

                                    </td>


                                    <!-- Units -->
                                    <td class="px-6 py-4 text-slate-700">

                                        @request.UnitsRequired

                                    </td>


                                    <!-- Urgency -->
                                    <td class="px-6 py-4">

                                        <span class="px-3 py-1 rounded-full text-xs font-semibold
                                            @(request.Urgency == "Emergency"
                                                ? "bg-red-100 text-red-700"
                                                : "bg-yellow-100 text-yellow-700")">

                                            @request.Urgency

                                        </span>

                                    </td>


                                    <!-- Status -->
                                    <td class="px-6 py-4">

                                        <span class="px-3 py-1 rounded-full text-xs font-semibold
                                            @(request.Status == "Fulfilled"
                                                ? "bg-green-100 text-green-700"
                                                : "bg-blue-100 text-blue-700")">

                                            @request.Status

                                        </span>

                                    </td>


                                    <!-- Respond -->
                                    <td class="px-6 py-4 text-right">

                                        <form asp-controller="DonationRequest"
                                              asp-action="Respond"
                                              method="post">

                                            <input type="hidden"
                                                   name="requestId"
                                                   value="@request.Id" />

                                            <button type="submit"
                                                    class="bg-rose-500 hover:bg-rose-600
                                                text-white px-4 py-2 rounded-xl
                                                text-sm font-medium transition">

                                                <i class="fa-solid fa-hand-holding-heart mr-1"></i>

                                                Respond

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- No Requests -->
                <div class="px-6 py-12 text-center">

                    <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-slate-100
                        flex items-center justify-center">

                        <i class="fa-solid fa-droplet text-slate-400 text-xl"></i>

                    </div>

                    <h3 class="text-lg font-semibold text-slate-700">
                        No blood requests found
                    </h3>

                    <p class="text-sm text-slate-500 mt-1">
                        There are currently no requests matching your search.
                    </p>

                </div>
            }

        </div>

    </div>

</div>
