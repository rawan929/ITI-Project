@model ITI.BLL.ViewModel.BloodBankDashboardVM

@{
    Layout = "_Layout";
    ViewData["Title"] = "Blood Bank Dashboard";
    ViewData["ActiveTab"] = "Overview";

    var maxUnits = Model.Inventory.Any() ? Math.Max(Model.Inventory.Max(i => i.UnitsAvailable), 1) : 1;
}

<div class="bank-page">

    @await Html.PartialAsync("_BankHeader")

    <div class="container-fluid" style="max-width:1200px;">

        <!-- Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-uppercase text-muted small fw-bold">Units In Stock</span>
                        <div class="stat-icon" style="background:rgba(179,18,43,.08);">🩸</div>
                    </div>
                    <h2 class="fw-bold">@Model.TotalUnitsInStock</h2>
                    <p class="text-muted small mb-0">Across all blood types</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-uppercase text-muted small fw-bold">Donations</span>
                        <div class="stat-icon bg-light">📋</div>
                    </div>
                    <h2 class="fw-bold">@Model.TotalDonations</h2>
                    <p class="text-muted small mb-0">@Model.DonationsThisMonth this month</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-uppercase text-muted small fw-bold">Appointments</span>
                        <div class="stat-icon bg-primary bg-opacity-10">📅</div>
                    </div>
                    <h2 class="fw-bold">@Model.UpcomingAppointments</h2>
                    <p class="text-muted small mb-0">Scheduled and still to come</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-uppercase text-muted small fw-bold">Low Stock</span>
                        <div class="stat-icon bg-warning bg-opacity-10">⚠️</div>
                    </div>
                    <h2 class="fw-bold">@Model.LowStockTypesCount</h2>
                    <p class="text-muted small mb-0">Blood types at 5 units or fewer</p>
                </div>
            </div>
        </div>

        <div class="row g-3">

            <!-- Inventory snapshot -->
            <div class="col-12 col-lg-7">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                            <div>
                                <p class="text-uppercase text-muted small fw-bold mb-1">Current Stock</p>
                                <h2 class="h5 fw-bold mb-1">Blood Inventory</h2>
                                <p class="text-muted small mb-0">Units currently held by @Model.Name.</p>
                            </div>
                            <a asp-action="Inventory" class="btn btn-brand">Manage Stock</a>
                        </div>

                        <div class="row g-3">
                            @foreach (var item in Model.Inventory)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="blood-chip">@item.BloodTypeName</div>
                                        <div>
                                            <div class="fw-bold">@item.UnitsAvailable</div>
                                            <div class="text-muted" style="font-size:.72rem;">units</div>
                                        </div>
                                    </div>
                                    <div class="stock-bar mb-1">
                                        <span style="width:@(Math.Min(100, item.UnitsAvailable * 100 / maxUnits))%;"></span>
                                    </div>
                                    @if (item.IsOutOfStock)
                                    {
                                        <span class="badge rounded-pill" style="background:rgba(179,18,43,.1); color:var(--brand-red); font-size:.65rem;">Out of stock</span>
                                    }
                                    else if (item.IsLowStock)
                                    {
                                        <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning-emphasis" style="font-size:.65rem;">Low</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-success bg-opacity-25 text-success-emphasis" style="font-size:.65rem;">Healthy</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent donations -->
            <div class="col-12 col-lg-5">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                            <div>
                                <p class="text-uppercase text-muted small fw-bold mb-1">Activity</p>
                                <h2 class="h5 fw-bold mb-1">Recent Donations</h2>
                            </div>
                            <a asp-action="RecordDonation" class="btn btn-brand">+ Record</a>
                        </div>

                        @if (!Model.RecentDonations.Any())
                        {
                            <div class="text-center py-4">
                                <div class="icon-circle bg-light mx-auto mb-3">🩸</div>
                                <h6 class="fw-bold">No donations yet</h6>
                                <p class="text-muted small mb-3">Record your first donation to start building stock.</p>
                                <a asp-action="RecordDonation" class="btn btn-brand btn-sm">Record a Donation</a>
                            </div>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var donation in Model.RecentDonations)
                                {
                                    <li class="d-flex align-items-center gap-3 py-2 border-bottom">
                                        <div class="blood-chip" style="width:38px;height:38px;font-size:.8rem;">@donation.BloodTypeName</div>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold small">@donation.DonorName</div>
                                            <div class="text-muted" style="font-size:.75rem;">
                                                @donation.DonationDate.ToString("dd MMM yyyy")
                                            </div>
                                        </div>
                                        <span class="fw-bold small">+@donation.Units</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
