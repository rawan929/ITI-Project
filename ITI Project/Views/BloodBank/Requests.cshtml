@model List<ITI.BLL.ViewModel.BloodBankIncomingRequestVM>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Hospital Requests";
    ViewData["ActiveTab"] = "Requests";

    var isApproved = (bool)(ViewBag.IsBloodBankApproved ?? false);
    var sameCityOnly = (bool)(ViewBag.SameCityOnly ?? true);
    var coverable = Model.Count(r => r.CanFulfill);
}

<div class="bank-page">

    @await Html.PartialAsync("_BankHeader")

    <div class="container-fluid" style="max-width:1200px;">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                    <div>
                        <p class="text-uppercase text-muted small fw-bold mb-1">Hospital Demand</p>
                        <h2 class="h5 fw-bold mb-1">Open Blood Requests</h2>
                        <p class="text-muted small mb-0">
                            @Model.Count open requests · you can cover @coverable of them from stock.
                        </p>
                    </div>

                    <div class="btn-group">
                        <a asp-action="Requests" asp-route-sameCityOnly="true"
                           class="btn btn-sm @(sameCityOnly ? "btn-brand" : "btn-outline-secondary")">My City</a>
                        <a asp-action="Requests" asp-route-sameCityOnly="false"
                           class="btn btn-sm @(sameCityOnly ? "btn-outline-secondary" : "btn-brand")">All Cities</a>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <div class="icon-circle bg-light mx-auto mb-3">🏥</div>
                        <h5 class="fw-bold">No Open Requests</h5>
                        <p class="text-muted small mb-0">
                            No hospital @(sameCityOnly ? "in your city " : "")has an open blood request right now.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr class="text-uppercase text-muted small">
                                    <th>Hospital</th>
                                    <th>Blood Type</th>
                                    <th>Needed</th>
                                    <th>In Stock</th>
                                    <th>Urgency</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@request.HospitalName</div>
                                            <div class="text-muted" style="font-size:.75rem;">
                                                @request.HospitalCity
                                                @if (!string.IsNullOrWhiteSpace(request.HospitalPhone))
                                                {
                                                    <text> · @request.HospitalPhone</text>
                                                }
                                            </div>
                                        </td>
                                        <td><span class="fw-bold">🩸 @request.BloodTypeName</span></td>
                                        <td>@request.UnitsRequired <span class="text-muted small">units</span></td>
                                        <td>
                                            @if (request.CanFulfill)
                                            {
                                                <span class="text-success fw-semibold">@request.UnitsInStock</span>
                                            }
                                            else
                                            {
                                                <span style="color:var(--brand-red);" class="fw-semibold">@request.UnitsInStock</span>
                                            }
                                        </td>
                                        <td>
                                            @if (request.Urgency == "Emergency")
                                            {
                                                <span class="badge rounded-pill" style="background:rgba(179,18,43,.1); color:var(--brand-red);">Emergency</span>
                                            }
                                            else if (request.Urgency == "Urgent")
                                            {
                                                <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning-emphasis">Urgent</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-light text-dark">@request.Urgency</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (!isApproved)
                                            {
                                                <span class="text-muted small">Pending approval</span>
                                            }
                                            else if (request.CanFulfill)
                                            {
                                                <form asp-action="FulfillRequest" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@request.RequestId" />
                                                    <input type="hidden" name="sameCityOnly" value="@sameCityOnly.ToString().ToLower()" />
                                                    <button type="submit" class="btn btn-sm btn-brand">
                                                        Fulfil (−@request.UnitsRequired)
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Not enough stock</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="text-muted small mb-0 mt-3">
                        Fulfilling issues the exact blood type requested. Substituting a compatible
                        type is a medical decision, so it isn't done automatically here.
                    </p>
                }
            </div>
        </div>
    </div>
</div>
