@model ITI.BLL.ViewModel.BloodBankRecordDonationVM

@{
    Layout = "_Layout";
    ViewData["Title"] = "Record Donation";
    ViewData["ActiveTab"] = "RecordDonation";

    var isApproved = (bool)(ViewBag.IsBloodBankApproved ?? false);
    var eligibleCount = Model.AvailableDonors.Count(d => d.IsEligible);
}

<div class="bank-page">

    @await Html.PartialAsync("_BankHeader")

    <div class="container-fluid" style="max-width:1200px;">
        <div class="row g-3">

            <div class="col-12 col-lg-7">
                <div class="card">
                    <div class="card-body p-4">
                        <p class="text-uppercase text-muted small fw-bold mb-1">Donation Intake</p>
                        <h2 class="h5 fw-bold mb-1">Record a Donation</h2>
                        <p class="text-muted small mb-4">
                            The units are added to your inventory under the donor's own blood type,
                            and the donor's 90-day eligibility clock is reset.
                        </p>

                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <form asp-action="RecordDonation" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="DonorId" class="form-label small fw-semibold"></label>
                                <select asp-for="DonorId" class="form-select" required>
                                    <option value="">Choose a donor</option>
                                    @foreach (var donor in Model.AvailableDonors)
                                    {
                                        <option value="@donor.DonorId">
                                            @donor.FullName — @donor.BloodTypeName@(donor.IsEligible ? "" : " (not eligible yet)")
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="DonorId" class="text-danger small"></span>
                                <div class="form-text">
                                    Showing donors registered in your city who have set a blood type.
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <label asp-for="Units" class="form-label small fw-semibold"></label>
                                    <input asp-for="Units" class="form-control" type="number" min="1" max="5" />
                                    <span asp-validation-for="Units" class="text-danger small"></span>
                                </div>
                                <div class="col-6">
                                    <label asp-for="DonationDate" class="form-label small fw-semibold"></label>
                                    <input asp-for="DonationDate" class="form-control" type="date" />
                                    <span asp-validation-for="DonationDate" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="form-check mb-4">
                                <input asp-for="OverrideEligibility" class="form-check-input" type="checkbox" />
                                <label asp-for="OverrideEligibility" class="form-check-label small"></label>
                                <div class="form-text">
                                    Only tick this if the donor's recorded history is wrong. It skips the
                                    90-day check, so it should be a deliberate staff decision.
                                </div>
                            </div>

                            <button type="submit" class="btn btn-brand" disabled="@(!isApproved)">
                                Record Donation
                            </button>

                            @if (!isApproved)
                            {
                                <p class="text-muted small mt-2 mb-0">
                                    Available once an admin approves your blood bank.
                                </p>
                            }
                        </form>
                    </div>
                </div>
            </div>

            <!-- Donor eligibility list -->
            <div class="col-12 col-lg-5">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <p class="text-uppercase text-muted small fw-bold mb-1">Donor Pool</p>
                        <h2 class="h5 fw-bold mb-1">Eligibility</h2>
                        <p class="text-muted small mb-4">
                            @eligibleCount of @Model.AvailableDonors.Count donors in your city can donate today.
                        </p>

                        @if (!Model.AvailableDonors.Any())
                        {
                            <div class="text-center py-4">
                                <div class="icon-circle bg-light mx-auto mb-3">👤</div>
                                <h6 class="fw-bold">No donors found</h6>
                                <p class="text-muted small mb-0">
                                    No active donors in your city have set a blood type yet.
                                </p>
                            </div>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0" style="max-height:420px; overflow-y:auto;">
                                @foreach (var donor in Model.AvailableDonors)
                                {
                                    <li class="d-flex align-items-center gap-3 py-2 border-bottom">
                                        <div class="blood-chip" style="width:38px;height:38px;font-size:.8rem;">@donor.BloodTypeName</div>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold small">@donor.FullName</div>
                                            <div class="text-muted" style="font-size:.75rem;">
                                                @if (donor.LastDonationDate.HasValue)
                                                {
                                                    <text>Last donated @donor.LastDonationDate.Value.ToString("dd MMM yyyy")</text>
                                                }
                                                else
                                                {
                                                    <text>No donations recorded</text>
                                                }
                                            </div>
                                        </div>
                                        @if (donor.IsEligible)
                                        {
                                            <span class="badge rounded-pill bg-success bg-opacity-25 text-success-emphasis" style="font-size:.65rem;">Eligible</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning-emphasis" style="font-size:.65rem;">
                                                @(donor.NextEligibleDate?.ToString("dd MMM") ?? "Waiting")
                                            </span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
