@model ITI.BLL.ViewModel.Donor.DonorProfileViewViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_DonorLayout";
}

<style>
    .profile-view-container {
        padding: 30px 40px;
        background: #f5f6f8;
        min-height: 60vh;
    }

    .profile-view-card {
        background: #fff;
        border-radius: 10px;
        padding: 30px;
        border: 1px solid #eaeaea;
        max-width: 700px;
        margin-bottom: 20px;
    }

    .profile-view-card h5 {
        font-family: Georgia, serif;
        margin-bottom: 20px;
    }

    .info-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #888;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }

    .info-value {
        font-size: 0.95rem;
        color: #222;
        margin-bottom: 18px;
    }

    .btn-edit-profile {
        background: #b3122b;
        color: #fff;
        font-weight: 700;
        padding: 10px 24px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
    }

    .btn-edit-profile:hover {
        background: #8f0e22;
        color: #fff;
    }
</style>

@await Html.PartialAsync("_DonorHeader", (ITI.BLL.ViewModel.Donor.DonorHeaderViewModel)ViewBag.Header)

<div class="profile-view-container">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="max-width:700px;">@TempData["SuccessMessage"]</div>
    }

    <div class="profile-view-card">
        <div class="row">
            <div class="col-md-6">
                <div class="info-label">Full Name</div>
                <div class="info-value">@Model.FullName</div>
            </div>
            <div class="col-md-6">
                <div class="info-label">Email</div>
                <div class="info-value">@Model.Email</div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="info-label">Phone</div>
                <div class="info-value">@Model.Phone</div>
            </div>
            <div class="col-md-6">
                <div class="info-label">Date of Birth</div>
                <div class="info-value">@(Model.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "Not set")</div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="info-label">Blood Type</div>
                <div class="info-value">@Model.BloodTypeName</div>
            </div>
            <div class="col-md-6">
                <div class="info-label">City</div>
                <div class="info-value">@Model.City</div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="info-label">Last Donation</div>
                <div class="info-value">@(Model.LastDonationDate?.ToString("MMM dd, yyyy") ?? "N/A")</div>
            </div>
            <div class="col-md-6">
                <div class="info-label">Eligibility Status</div>
                <div class="info-value">
                    @if (Model.IsEligible)
                    {
                        <span style="color:#22c55e;font-weight:600;">Eligible now</span>
                    }
                    else
                    {
                        <span>Eligible from @Model.EligibleFromDate?.ToString("MMM dd, yyyy")</span>
                    }
                </div>
            </div>
        </div>

        <a asp-action="EditProfile" asp-controller="Donor" class="btn-edit-profile">Edit Profile</a>
    </div>

    <div class="profile-view-card">
        <h5>Medical Information</h5>
        <div class="row">
            <div class="col-md-6">
                <div class="info-label">Weight</div>
                <div class="info-value">@(Model.Weight.HasValue ? $"{Model.Weight} kg" : "Not set")</div>
            </div>
            <div class="col-md-6">
                <div class="info-label">Height</div>
                <div class="info-value">@(Model.Height.HasValue ? $"{Model.Height} cm" : "Not set")</div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="info-label">Known Allergies</div>
                <div class="info-value">@(string.IsNullOrEmpty(Model.KnownAllergies) ? "None" : Model.KnownAllergies)</div>
            </div>
            <div class="col-md-6">
                <div class="info-label">Chronic Conditions</div>
                <div class="info-value">@(string.IsNullOrEmpty(Model.ChronicConditions) ? "None" : Model.ChronicConditions)</div>
            </div>
        </div>
    </div>
</div>