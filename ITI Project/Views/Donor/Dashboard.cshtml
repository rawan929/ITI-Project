@model ITI.BLL.ViewModel.Donor.DonorDashboardViewModel
@{
    ViewData["Title"] = "Donor Dashboard";
    Layout = "_DonorLayout";
}

<style>
    .stats-container {
        padding: 30px 40px;
        background: #f5f6f8;
    }

    .stat-card {
        background: #fff;
        border-radius: 10px;
        padding: 20px;
        border: 1px solid #eaeaea;
        height: 100%;
    }

    .stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #888;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-family: Georgia, serif;
        font-size: 1.8rem;
        font-weight: 700;
        margin: 6px 0 2px;
    }

        .stat-value.red {
            color: #b3122b;
        }

        .stat-value.green {
            color: #22c55e;
        }

    .stat-sub {
        font-size: 0.78rem;
        color: #999;
    }

    .placeholder-box {
        background: #fff;
        border: 1px dashed #ddd;
        border-radius: 10px;
        padding: 30px;
        text-align: center;
        color: #999;
        font-size: 0.9rem;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .view-all-link {
        color: #b3122b;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
    }

        .view-all-link:hover {
            text-decoration: underline;
        }
</style>

@await Html.PartialAsync("_DonorHeader", (ITI.BLL.ViewModel.Donor.DonorHeaderViewModel)ViewBag.Header)

<div class="stats-container">
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Blood Type</div>
                <div class="stat-value red">@Model.BloodTypeName</div>
                <div class="stat-sub">@(Model.BloodTypeName == "O-" ? "Universal donor" : "")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Donations</div>
                <div class="stat-value">@Model.TotalDonations</div>
                <div class="stat-sub">Since @Model.MemberSince</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Last Donation</div>
                <div class="stat-value" style="font-size:1.3rem;">
                    @(Model.LastDonationDate?.ToString("MMM dd") ?? "N/A")
                </div>
                <div class="stat-sub">@(Model.LastDonationDate?.ToString("yyyy") ?? "")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Next Eligible</div>
                @if (Model.IsEligible)
                {
                    <div class="stat-value green" style="font-size:1.3rem;">Now</div>
                    <div class="stat-sub">You can donate today</div>
                }
                else
                {
                    <div class="stat-value green" style="font-size:1.3rem;">
                        @Model.NextEligibleDate?.ToString("MMM dd")
                    </div>
                    <div class="stat-sub">@Model.NextEligibleDate?.ToString("yyyy") · @Model.DaysUntilEligible days</div>
                }
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-8">
            <div class="placeholder-box">
                <div class="section-header mb-2" style="text-align:left;">
                    <strong>🩸 Nearby Blood Requests</strong>
                    <a href="#" class="view-all-link">View all</a>
                </div>
                <small>Coming soon — depends on Blood Request module</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="placeholder-box">
                🔔 Notifications<br />
                <small>Coming soon — depends on Notifications module</small>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <div class="placeholder-box">
            📅 Upcoming Appointment<br />
            <small>Coming soon — depends on Appointments module</small>
        </div>
    </div>
</div>