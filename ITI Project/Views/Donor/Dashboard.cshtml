@model ITI.BLL.ViewModel.Donor.DonorDashboardViewModel
@{
    ViewData["Title"] = "Donor Dashboard";
}

<style>
    .donor-header {
        background: #0f1420;
        color: #fff;
        padding: 30px 40px;
        border-radius: 0;
    }

    .donor-avatar {
        width: 60px;
        height: 60px;
        background: #b3122b;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.3rem;
    }

    .donor-header .welcome-text {
        color: #b7bac2;
        font-size: 0.85rem;
        margin-bottom: 2px;
    }

    .donor-header h3 {
        font-family: Georgia, serif;
        margin-bottom: 2px;
    }

    .donor-header .since-text {
        color: #9a9da5;
        font-size: 0.85rem;
    }

    .badge-eligible {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .badge-not-eligible {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .nav-tabs-custom {
        background: #0f1420;
        padding: 0 40px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .nav-tabs-custom a {
        color: #9a9da5;
        text-decoration: none;
        padding: 14px 4px;
        margin-right: 30px;
        display: inline-block;
        font-size: 0.9rem;
        border-bottom: 2px solid transparent;
    }

    .nav-tabs-custom a.active {
        color: #fff;
        border-bottom-color: #b3122b;
        font-weight: 600;
    }

    .stats-container {
        padding: 30px 40px;
        background: #f5f6f8;
    }

    .stat-card {
        background: #fff;
        border-radius: 10px;
        padding: 20px;
        border: 1px solid #eaeaea;
        height: 100%;
    }

    .stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #888;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-family: Georgia, serif;
        font-size: 1.8rem;
        font-weight: 700;
        margin: 6px 0 2px;
    }

    .stat-value.red { color: #b3122b; }
    .stat-value.green { color: #22c55e; }

    .stat-sub {
        font-size: 0.78rem;
        color: #999;
    }

    .placeholder-box {
        background: #fff;
        border: 1px dashed #ddd;
        border-radius: 10px;
        padding: 30px;
        text-align: center;
        color: #999;
        font-size: 0.9rem;
    }
</style>

<div class="donor-header d-flex justify-content-between align-items-start flex-wrap">
    <div class="d-flex gap-3">
        <div class="donor-avatar">
            @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, Math.Min(2, Model.FullName.Length)).ToUpper() : "??")
        </div>
        <div>
            <div class="welcome-text">Welcome back</div>
            <h3>@Model.FullName</h3>
            <div class="since-text">Registered donor since @Model.MemberSince</div>
        </div>
    </div>
    <div class="mt-2">
        @if (Model.IsEligible)
        {
            <span class="badge-eligible">● Eligible to Donate</span>
        }
        else
        {
            <span class="badge-not-eligible">● Not Eligible Yet</span>
        }
    </div>
</div>

<div class="nav-tabs-custom">
    <a href="#" class="active">Overview</a>
    <a href="#" onclick="alert('Coming soon - waiting on Blood Bank module'); return false;">History</a>
    <a href="#" onclick="alert('Coming soon - waiting on Blood Bank module'); return false;">Appointments</a>
</div>

<div class="stats-container">
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Blood Type</div>
                <div class="stat-value red">@Model.BloodTypeName</div>
                <div class="stat-sub">@(Model.BloodTypeName == "O-" ? "Universal donor" : "")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Total Donations</div>
                <div class="stat-value">@Model.TotalDonations</div>
                <div class="stat-sub">Since @Model.MemberSince</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Last Donation</div>
                <div class="stat-value" style="font-size:1.3rem;">
                    @(Model.LastDonationDate?.ToString("MMM dd") ?? "N/A")
                </div>
                <div class="stat-sub">@(Model.LastDonationDate?.ToString("yyyy") ?? "")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-label">Next Eligible</div>
                @if (Model.IsEligible)
                {
                    <div class="stat-value green" style="font-size:1.3rem;">Now</div>
                    <div class="stat-sub">You can donate today</div>
                }
                else
                {
                    <div class="stat-value green" style="font-size:1.3rem;">
                        @Model.NextEligibleDate?.ToString("MMM dd")
                    </div>
                    <div class="stat-sub">@Model.NextEligibleDate?.ToString("yyyy") · @Model.DaysUntilEligible days</div>
                }
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-8">
            <div class="placeholder-box">
                🩸 Nearby Blood Requests<br />
                <small>Coming soon — depends on Blood Request module</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="placeholder-box">
                🔔 Notifications<br />
                <small>Coming soon — depends on Notifications module</small>
            </div>
        </div>
    </div>
</div>