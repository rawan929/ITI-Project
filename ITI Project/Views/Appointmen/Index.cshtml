@model IEnumerable<ITI.BLL.ViewModel.AppointmentVM>

@{
    ViewData["Title"] = "Appointments List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Appointments List</h2>
        <a asp-action="Create" class="btn btn-primary">Book New Appointment</a>
    </div>

    <table class="table table-striped table-hover border mt-3">
        <thead class="table-dark">
            <tr>
                <th>Donor Name</th>
                <th>Appointment Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(string.IsNullOrEmpty(item.DonorName) ? "N/A" : item.DonorName)</td>
                        <td>@item.AppointmentDate.ToString("yyyy-MM-dd hh:mm tt")</td>
                        <td>
                            <span class="badge @(item.Status == "Pending" ? "bg-warning text-dark" : "bg-success")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            
                            <span class="text-muted">No Actions</span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No appointments found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>