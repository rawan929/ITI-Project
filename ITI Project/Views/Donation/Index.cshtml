@model IEnumerable<ITI.BLL.ViewModel.DonationVM>

@{
    ViewData["Title"] = "Donations List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Donations List</h2>
        <a asp-action="Record" class="btn btn-primary">Record New Donation</a>
    </div>

    <table class="table table-striped table-hover border mt-3">
        <thead class="table-dark">
            <tr>
                <th>Donor Name</th>
                <th>Units</th>
                <th>Donation Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(string.IsNullOrEmpty(item.DonorName) ? "N/A" : item.DonorName)</td>
                        <td>@item.Units</td>
                        <td>@item.DonationDate.ToString("yyyy-MM-dd hh:mm tt")</td>
                        <td>
                            <span class="badge bg-success">@item.Status</span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No donations found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>