@model IEnumerable<ITI.BLL.ViewModel.DonationVM>
@using ITI.BLL.Constants

@{
    Layout = "_Layout";
    ViewData["Title"] = "Donations";
    var total = Model?.Count() ?? 0;
    var inTesting = Model?.Count(d => d.Status == DonationStatuses.InTesting) ?? 0;
}

@functions {
    static string BadgeClass(string? status) => status switch
    {
        DonationStatuses.InTesting => "bg-amber-50 text-amber-600 border-amber-200",
        DonationStatuses.Completed => "bg-emerald-50 text-emerald-600 border-emerald-200",
        _ => "bg-red-50 text-red-600 border-red-200"
    };
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .bg-admin-dark {
        background-color: #0A1628;
    }

    .text-rose-brand {
        color: #C41230;
    }

    .bg-rose-brand {
        background-color: #C41230;
    }
</style>

<!-- Header -->
<div class="bg-admin-dark text-white -mx-4 sm:-mx-6 lg:-mx-8 -mt-4 px-6 sm:px-8 pt-8 pb-8 mb-8 rounded-b-2xl">
    <div class="max-w-7xl mx-auto flex items-center gap-4">
        <div class="w-12 h-12 bg-rose-brand rounded-2xl flex items-center justify-center text-white shadow-lg shadow-rose-900/40">
            <i class="fa-solid fa-droplet text-xl"></i>
        </div>
        <div>
            <p class="text-xs text-slate-400 font-medium">Donations Management</p>
            <h1 class="text-2xl font-bold tracking-tight font-serif">Incoming <span class="text-rose-brand">Donations</span></h1>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto">
    @if (TempData["Success"] is string successMessage)
    {
        <div class="mb-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium">@successMessage</div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="mb-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-600 text-sm font-medium">@errorMessage</div>
    }

    <div class="flex items-center justify-between mb-4">
        <span class="text-sm text-slate-500">@total donations recorded</span>
        <span class="text-sm font-semibold text-rose-brand">@inTesting in testing</span>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 border-b border-slate-200 text-xs font-bold uppercase text-slate-400">
                    <tr>
                        <th class="px-6 py-4">Donation ID</th>
                        <th class="px-6 py-4">Donor</th>
                        <th class="px-6 py-4">Blood Type</th>
                        <th class="px-6 py-4">Units</th>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4">Time</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var local = item.DonationDate.ToLocalTime();
                            <tr class="hover:bg-slate-50/50 transition">
                                <td class="px-6 py-4 font-mono text-xs text-slate-400">@item.Code</td>
                                <td class="px-6 py-4 font-semibold text-slate-900">@(string.IsNullOrEmpty(item.DonorName) ? "N/A" : item.DonorName)</td>
                                <td class="px-6 py-4">@(item.BloodType ?? "-")</td>
                                <td class="px-6 py-4">@item.Units</td>
                                <td class="px-6 py-4">@local.ToString("MMM dd, yyyy")</td>
                                <td class="px-6 py-4">@local.ToString("hh:mm tt")</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border @BadgeClass(item.Status)">
                                        @DonationStatuses.Display(item.Status)
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    @if (item.Status == DonationStatuses.InTesting)
                                    {
                                        <form asp-action="MarkProcessed" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="bloodBankId" value="@ViewBag.BloodBankId" />
                                            <button type="submit" class="px-3 py-1 border border-rose-300 text-rose-700 rounded-lg text-xs font-semibold">
                                                Mark Processed
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="px-6 py-8 text-center text-slate-400 font-medium">No donations recorded yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>