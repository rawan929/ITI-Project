@model ITI.BLL.ViewModel.CreateDonationVM

@{
    ViewData["Title"] = "Record Donation";
}

<div class="container mt-4">
    <h2>Record New Donation</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Record" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="DonorId" class="control-label">Donor ID</label>
                    <input asp-for="DonorId" class="form-control" />
                    <span asp-validation-for="DonorId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="BloodBankId" class="control-label">Blood Bank ID</label>
                    <input asp-for="BloodBankId" class="form-control" />
                    <span asp-validation-for="BloodBankId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Units" class="control-label">Units (Bags)</label>
                    <input asp-for="Units" class="form-control" />
                    <span asp-validation-for="Units" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-success">Save Donation</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>