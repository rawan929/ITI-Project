@model ITI.BLL.ViewModel.ScheduleAppointmentVM
@{
    ViewData["Title"] = "Book Appointment";
}

<style>
    .donor-header { background:#0f1420; color:#fff; padding:30px 40px; }
    .schedule-container { padding:30px 40px; background:#f5f6f8; min-height:60vh; }
    .schedule-card { background:#fff; border-radius:10px; padding:24px; border:1px solid #eaeaea; max-width:520px; }
    .btn-brand { background:#b3122b; border-color:#b3122b; color:#fff; font-weight:700; }
    .btn-brand:hover { background:#8f0e22; border-color:#8f0e22; color:#fff; }
</style>

<div class="donor-header">
    <p class="mb-0" style="color:#b7bac2; font-size:.85rem;">Almost done</p>
    <h3 class="mb-0">Book Your Appointment</h3>
</div>

<div class="schedule-container">
    <div class="schedule-card">
        <div class="mb-3 p-3 rounded-3" style="background:rgba(179,18,43,.06);">
            <div class="fw-bold">@Model.HospitalName</div>
            <div class="text-muted small">Blood type needed: @Model.BloodTypeName</div>
        </div>

        <form asp-action="Schedule" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="DonationRequestId" />
            <input type="hidden" asp-for="HospitalName" />
            <input type="hidden" asp-for="BloodTypeName" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label asp-for="BloodBankId" class="form-label small fw-bold">You'll donate at</label>
                <select asp-for="BloodBankId" class="form-select">
                    <option value="">Choose a blood bank</option>
                    @foreach (var bank in Model.AvailableBloodBanks)
                    {
                        <option value="@bank.BloodBankId">@bank.Name — @bank.City, @bank.Address</option>
                    }
                </select>
                <span asp-validation-for="BloodBankId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AppointmentDate" class="form-label small fw-bold"></label>
                <input asp-for="AppointmentDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-brand w-100">Confirm Appointment</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
