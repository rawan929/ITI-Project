@model List<ITI.BLL.ViewModel.DonorInboxItemVM>

@{
    ViewData["Title"] = "My Requests";
    var awaiting = Model.Count(x => x.IsAwaitingReply);
}

<style>
    .donor-header { background:#0f1420; color:#fff; padding:30px 40px; }
    .donor-avatar { width:60px; height:60px; background:#b3122b; border-radius:10px; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:1.3rem; }
    .donor-header .welcome-text { color:#b7bac2; font-size:.85rem; margin-bottom:2px; }
    .donor-header h3 { font-family:Georgia, serif; margin-bottom:2px; }
    .nav-tabs-custom { background:#0f1420; padding:0 40px; border-bottom:1px solid rgba(255,255,255,.1); }
    .nav-tabs-custom a { color:#9a9da5; text-decoration:none; padding:14px 4px; margin-right:30px; display:inline-block; font-size:.9rem; border-bottom:2px solid transparent; }
    .nav-tabs-custom a.active { color:#fff; border-bottom-color:#b3122b; font-weight:600; }
    .inbox-container { padding:30px 40px; background:#f5f6f8; min-height:60vh; }
    .inbox-card { background:#fff; border-radius:10px; padding:20px; border:1px solid #eaeaea; }
    .inbox-card.awaiting { border-left:4px solid #b3122b; }
    .blood-chip { width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-weight:700; background:rgba(179,18,43,.08); color:#b3122b; }
    .btn-brand { background:#b3122b; border-color:#b3122b; color:#fff; font-weight:700; }
    .btn-brand:hover { background:#8f0e22; border-color:#8f0e22; color:#fff; }
</style>

<div class="donor-header d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div class="d-flex align-items-center gap-3">
        <div class="donor-avatar">📨</div>
        <div>
            <p class="welcome-text mb-0">Blood Requests</p>
            <h3 class="mb-0">My Requests</h3>
            <p class="welcome-text mb-0">
                @awaiting request@(awaiting == 1 ? "" : "s") waiting for your answer
            </p>
        </div>
    </div>
</div>

<div class="nav-tabs-custom">
    <a asp-action="Dashboard" asp-controller="Donor">Overview</a>
    <a asp-action="Index" asp-controller="DonationRequest" class="active">My Requests</a>
    <a asp-action="History" asp-controller="Donor">History</a>
    <a asp-action="Appointments" asp-controller="Donor">Appointments</a>
</div>

<div class="inbox-container">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 small">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 small">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="inbox-card text-center py-5">
            <div class="mb-2" style="font-size:2rem;">📨</div>
            <h5 class="fw-bold">No Requests Yet</h5>
            <p class="text-muted small mb-3">
                When a hospital needs your blood type, the request will appear here.
            </p>
            <a asp-controller="BloodRequest" asp-action="Index" class="btn btn-brand btn-sm">
                Browse Open Requests
            </a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="inbox-card @(item.IsAwaitingReply ? "awaiting" : "")">
                        <div class="d-flex align-items-center gap-3 flex-wrap">

                            <div class="blood-chip">@item.BloodTypeName</div>

                            <div class="flex-grow-1">
                                <div class="fw-bold">@item.HospitalName</div>
                                <div class="text-muted small">
                                    📍 @item.HospitalCity
                                    · @item.UnitsRequired unit@(item.UnitsRequired == 1 ? "" : "s") needed
                                    @if (!string.IsNullOrWhiteSpace(item.HospitalPhone))
                                    {
                                        <text> · 📞 @item.HospitalPhone</text>
                                    }
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                @if (item.Urgency == "Emergency")
                                {
                                    <span class="badge rounded-pill" style="background:rgba(179,18,43,.1); color:#b3122b;">Emergency</span>
                                }
                                else if (item.Urgency == "Urgent")
                                {
                                    <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning-emphasis">Urgent</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-light text-dark">@item.Urgency</span>
                                }

                                @switch (item.ResponseStatus)
                                {
                                    case "Scheduled":
                                        <span class="badge rounded-pill bg-success bg-opacity-25 text-success-emphasis">
                                            ✔ Scheduled @item.AppointmentDate?.ToString("dd MMM, h:mm tt") · @item.BloodBankName
                                        </span>
                                        break;
                                    case "Accepted":
                                        <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning-emphasis">Accepted — pick a time</span>
                                        break;
                                    case "Declined":
                                        <span class="badge rounded-pill bg-light text-muted">You declined</span>
                                        break;
                                    default:
                                        <span class="badge rounded-pill bg-primary bg-opacity-25 text-primary-emphasis">Awaiting your reply</span>
                                        break;
                                }

                                @if (item.RequestStatus != "Pending")
                                {
                                    <span class="badge rounded-pill bg-light text-muted">Request @item.RequestStatus</span>
                                }
                            </div>

                            @if (item.IsAwaitingReply)
                            {
                                <div class="d-flex gap-2">
                                    <form asp-action="Accept" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.DonationRequestId" />
                                        <button type="submit" class="btn btn-sm btn-brand">Accept</button>
                                    </form>
                                    <form asp-action="Decline" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.DonationRequestId" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Decline</button>
                                    </form>
                                </div>
                            }
                            else if (item.NeedsScheduling)
                            {
                                <a asp-action="Schedule" asp-route-id="@item.DonationRequestId" class="btn btn-sm btn-brand">
                                    Book Appointment
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
