@model ITI.BLL.ViewModel.CreateBloodRequestViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Blood Request";
}

<!-- Header -->
<div class="bg-[#0A1628] text-white -mx-4 sm:-mx-6 lg:-mx-8 -mt-4 px-6 sm:px-8 pt-8 pb-0 mb-8">

    <div class="max-w-7xl mx-auto">

        <!-- Title -->
        <div class="flex items-center gap-4 mb-10">

            <!-- Icon -->
            <div class="w-14 h-14 bg-[#C41230] rounded-2xl flex items-center justify-center shadow-lg">

                <i class="fa-solid fa-droplet text-xl"></i>

            </div>


            <!-- Text -->
            <div>

                <p class="text-xs text-slate-400 font-medium">
                    Hospital Services
                </p>

                <h1 class="text-2xl font-bold tracking-tight font-serif">
                    BloodLink+ Hospital
                </h1>

                <p class="text-sm text-slate-400 mt-1">
                    Create Blood Request
                </p>

            </div>

        </div>


        <!-- Navigation -->
        <div class="flex items-center gap-8">

            <a asp-action="Dashboard"
               class="text-slate-400 hover:text-white
                text-sm pb-4 transition">
                Overview
            </a>

            <a asp-action="CreateRequest"
               class="text-white font-semibold text-sm
                border-b-2 border-white pb-4">
                Create Request
            </a>

        </div>

    </div>

</div>


<!-- Main Content -->
<div class="max-w-4xl mx-auto">

    <!-- Form Card -->
    <div class="bg-white rounded-2xl
        border border-slate-200/80
        shadow-sm">

        <!-- Card Header -->
        <div class="p-6 md:p-7
            border-b border-slate-100">

            <p class="text-xs font-bold text-slate-400
                uppercase tracking-wider">
                Emergency Blood Request
            </p>

            <h2 class="text-xl font-bold text-slate-900 mt-1">
                Request Details
            </h2>

            <p class="text-sm text-slate-400 mt-1">
                Enter the blood type, required units and urgency level.
            </p>

        </div>


        <!-- Form -->
        <div class="p-6 md:p-8">

            <form asp-action="CreateRequest"
                  method="post"
                  class="space-y-6">


                <!-- Blood Type -->
                <div>

                    <label asp-for="BloodTypeId"
                           class="block text-xs font-bold
                        text-slate-500
                        uppercase tracking-wider mb-2">

                        Blood Type

                    </label>


                    <select asp-for="BloodTypeId"
                            class="w-full px-4 py-3
                        rounded-xl
                        border border-slate-200
                        bg-white
                        text-sm text-slate-700
                        focus:outline-none
                        focus:ring-2
                        focus:ring-rose-200
                        focus:border-[#C41230]">

                        <option value="">
                            Select Blood Type
                        </option>

                        <option value="1">A+</option>
                        <option value="2">A-</option>
                        <option value="3">B+</option>
                        <option value="4">B-</option>
                        <option value="5">AB+</option>
                        <option value="6">AB-</option>
                        <option value="7">O+</option>
                        <option value="8">O-</option>

                    </select>


                    <span asp-validation-for="BloodTypeId"
                          class="text-xs text-[#C41230]">
                    </span>

                </div>


                <!-- Units Required -->
                <div>

                    <label asp-for="UnitsRequired"
                           class="block text-xs font-bold
                        text-slate-500
                        uppercase tracking-wider mb-2">

                        Units Required

                    </label>


                    <input asp-for="UnitsRequired"
                           type="number"
                           min="1"
                           max="100"
                           placeholder="Enter number of units"
                           class="w-full px-4 py-3
                    rounded-xl
                    border border-slate-200
                    bg-white
                    text-sm text-slate-700
                    focus:outline-none
                    focus:ring-2
                    focus:ring-rose-200
                    focus:border-[#C41230]" />


                    <span asp-validation-for="UnitsRequired"
                          class="text-xs text-[#C41230]">
                    </span>

                </div>


                <!-- Urgency -->
                <div>

                    <label asp-for="Urgency"
                           class="block text-xs font-bold
                        text-slate-500
                        uppercase tracking-wider mb-2">

                        Urgency

                    </label>


                    <select asp-for="Urgency"
                            class="w-full px-4 py-3
                        rounded-xl
                        border border-slate-200
                        bg-white
                        text-sm text-slate-700
                        focus:outline-none
                        focus:ring-2
                        focus:ring-rose-200
                        focus:border-[#C41230]">

                        <option value="">
                            Select Urgency
                        </option>

                        <option value="Normal">
                            Normal
                        </option>

                        <option value="Urgent">
                            Urgent
                        </option>

                        <option value="Emergency">
                            Emergency
                        </option>

                    </select>


                    <span asp-validation-for="Urgency"
                          class="text-xs text-[#C41230]">
                    </span>

                </div>


                <!-- Buttons -->
                <div class="flex items-center justify-end
                    gap-3 pt-6
                    border-t border-slate-100">


                    <!-- Cancel -->
                    <a asp-action="Dashboard"
                       class="px-5 py-2.5
                        rounded-xl
                        border border-slate-200
                        text-sm font-semibold
                        text-slate-600
                        hover:bg-slate-50
                        transition">

                        Cancel

                    </a>


                    <!-- Submit -->
                    <button type="submit"
                            class="inline-flex items-center
                        gap-2
                        bg-[#C41230]
                        hover:opacity-90
                        text-white
                        text-sm font-semibold
                        px-5 py-2.5
                        rounded-xl
                        transition">

                        <i class="fa-solid fa-paper-plane"></i>

                        Create Request

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
