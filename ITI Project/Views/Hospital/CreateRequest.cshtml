@model ITI.BLL.ViewModel.CreateBloodRequestViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Blood Request";
}

<style>
    .hosp-page { --brand-red:#b3122b; --brand-red-dark:#8f0e22; --dark-navy:#0f1420; font-family:'Segoe UI', Tahoma, sans-serif; }
    .hosp-page .btn-brand { background:var(--brand-red); border-color:var(--brand-red); color:#fff; font-weight:700; }
    .hosp-page .btn-brand:hover { background:var(--brand-red-dark); border-color:var(--brand-red-dark); color:#fff; }
    .hosp-page .card { border-radius:12px; border:1px solid #e5e7eb; }
    .hosp-page .icon-circle { width:56px; height:56px; border-radius:16px; display:flex; align-items:center; justify-content:center; }
    .hosp-page .hosp-header { background:var(--dark-navy); color:#fff; margin:-1rem -1rem 2rem -1rem; padding:2rem 1.5rem 0; }
    .hosp-page .hosp-nav-link { color:rgba(255,255,255,.6); text-decoration:none; font-size:.9rem; padding-bottom:1rem; display:inline-block; }
    .hosp-page .hosp-nav-link.active { color:#fff; font-weight:600; border-bottom:2px solid #fff; }
</style>

<div class="hosp-page">

    <div class="hosp-header">
        <div class="container-fluid" style="max-width:1200px;">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="icon-circle" style="background:var(--brand-red);">
                    <span style="font-size:1.4rem;">🩸</span>
                </div>
                <div>
                    <p class="mb-0 small text-white-50">Hospital Services</p>
                    <h1 class="h4 fw-bold mb-0" style="font-family:Georgia, serif;">BloodLink+ Hospital</h1>
                    <p class="mb-0 small text-white-50">Create Blood Request</p>
                </div>
            </div>
            <div class="d-flex gap-4">
                <a asp-action="Dashboard" class="hosp-nav-link">Overview</a>
                <a asp-action="CreateRequest" class="hosp-nav-link active">Create Request</a>
                <a asp-controller="BloodRequest" asp-action="Index" class="hosp-nav-link">Active Requests</a>
                <a asp-action="Profile" class="hosp-nav-link">Profile</a>
            </div>
        </div>
    </div>

    <div class="container" style="max-width:700px;">

        @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-warning">
                ⚠️
                @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <p class="text-uppercase text-muted small fw-bold mb-1">Emergency Blood Request</p>
                <h2 class="h5 fw-bold mb-1">Request Details</h2>
                <p class="text-muted small mb-4">Enter the blood type, required units and urgency level.</p>

                <form asp-action="CreateRequest" method="post">

                    <div class="mb-3">
                        <label asp-for="BloodTypeId" class="form-label text-uppercase small fw-bold text-muted"></label>
                        <select asp-for="BloodTypeId" class="form-select">
                            <option value="">Select Blood Type</option>
                            <option value="1">A+</option>
                            <option value="2">A-</option>
                            <option value="3">B+</option>
                            <option value="4">B-</option>
                            <option value="5">AB+</option>
                            <option value="6">AB-</option>
                            <option value="7">O+</option>
                            <option value="8">O-</option>
                        </select>
                        <span asp-validation-for="BloodTypeId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UnitsRequired" class="form-label text-uppercase small fw-bold text-muted"></label>
                        <input asp-for="UnitsRequired" type="number" min="1" max="100"
                               class="form-control" placeholder="Enter number of units" />
                        <span asp-validation-for="UnitsRequired" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Urgency" class="form-label text-uppercase small fw-bold text-muted"></label>
                        <select asp-for="Urgency" class="form-select">
                            <option value="">Select Urgency</option>
                            <option value="Normal">Normal</option>
                            <option value="Urgent">Urgent</option>
                            <option value="Emergency">Emergency</option>
                        </select>
                        <span asp-validation-for="Urgency" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-brand">Create Request</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}