@model List<ITI.DAL.Models.BloodRequest>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Hospital Dashboard";

    var totalRequests = Model?.Count ?? 0;
    var activeRequests = Model?.Count(x => x.Status != "Fulfilled") ?? 0;
    var fulfilledRequests = Model?.Count(x => x.Status == "Fulfilled") ?? 0;
    var emergencyRequests = Model?.Count(x => x.Urgency == "Emergency") ?? 0;
}

<style>
    .hosp-page {
        --brand-red: #b3122b;
        --brand-red-dark: #8f0e22;
        --dark-navy: #0f1420;
        font-family: 'Segoe UI', Tahoma, sans-serif;
    }

        .hosp-page .btn-brand {
            background: var(--brand-red);
            border-color: var(--brand-red);
            color: #fff;
            font-weight: 700;
        }

            .hosp-page .btn-brand:hover {
                background: var(--brand-red-dark);
                border-color: var(--brand-red-dark);
                color: #fff;
            }

        .hosp-page .card {
            border-radius: 12px;
            border: 1px solid #e5e7eb;
        }

        .hosp-page .icon-circle {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hosp-page .stat-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hosp-page .hosp-header {
            background: var(--dark-navy);
            color: #fff;
            margin: -1rem -1rem 2rem -1rem;
            padding: 2rem 1.5rem 0;
        }

        .hosp-page .hosp-nav-link {
            color: rgba(255,255,255,.6);
            text-decoration: none;
            font-size: .9rem;
            padding-bottom: 1rem;
            display: inline-block;
        }

            .hosp-page .hosp-nav-link.active {
                color: #fff;
                font-weight: 600;
                border-bottom: 2px solid #fff;
            }
</style>

<div class="hosp-page">

    <div class="hosp-header">
        <div class="container-fluid" style="max-width:1200px;">
            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-circle" style="background:var(--brand-red);">
                        <span style="font-size:1.4rem;">🏥</span>
                    </div>
                    <div>
                        <p class="mb-0 small text-white-50">Hospital Services</p>
                        <h1 class="h4 fw-bold mb-0" style="font-family:Georgia, serif;">BloodLink+ Hospital</h1>
                        <p class="mb-0 small text-white-50">Hospital Dashboard</p>
                    </div>
                </div>
                <span class="badge rounded-pill border text-success px-3 py-2">
                    <span class="d-inline-block rounded-circle bg-success" style="width:8px;height:8px;"></span>
                    Hospital Online
                </span>
            </div>
            <div class="d-flex gap-4">
                <a asp-action="Dashboard" class="hosp-nav-link active">Overview</a>
                <a asp-action="CreateRequest" class="hosp-nav-link">Create Request</a>
              <a asp-action="Profile" class="hosp-nav-link">Profile</a>
            </div>
        </div>
    </div>

    <div class="container-fluid" style="max-width:1200px;">

        <!-- Stats -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-uppercase text-muted small fw-bold">Total Requests</span>
                        <div class="stat-icon bg-light">📄</div>
                    </div>
                    <h2 class="fw-bold">@totalRequests</h2>
                    <p class="text-muted small mb-0">All blood requests</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-uppercase text-muted small fw-bold">Active Requests</span>
                        <div class="stat-icon" style="background:rgba(179,18,43,.08);">🩸</div>
                    </div>
                    <h2 class="fw-bold">@activeRequests</h2>
                    <p class="text-muted small mb-0">Requests waiting to be fulfilled</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-uppercase text-muted small fw-bold">Fulfilled</span>
                        <div class="stat-icon bg-success bg-opacity-10">✅</div>
                    </div>
                    <h2 class="fw-bold">@fulfilledRequests</h2>
                    <p class="text-muted small mb-0">Completed requests</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card h-100 p-3">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-uppercase text-muted small fw-bold">Emergency</span>
                        <div class="stat-icon bg-warning bg-opacity-10">⚠️</div>
                    </div>
                    <h2 class="fw-bold">@emergencyRequests</h2>
                    <p class="text-muted small mb-0">Emergency requests</p>
                </div>
            </div>
        </div>

        <!-- Requests -->
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                    <div>
                        <p class="text-uppercase text-muted small fw-bold mb-1">Hospital Requests</p>
                        <h2 class="h5 fw-bold mb-1">My Blood Requests</h2>
                        <p class="text-muted small mb-0">View and manage the blood requests created by your hospital.</p>
                    </div>
                    <a asp-action="CreateRequest" class="btn btn-brand">+ Create Request</a>
                </div>

                @if (Model == null || Model.Count == 0)
                {
                    <div class="text-center py-5">
                        <div class="icon-circle bg-light mx-auto mb-3">🩸</div>
                        <h5 class="fw-bold">No Blood Requests</h5>
                        <p class="text-muted small">Your hospital has not created any blood requests yet.</p>
                        <a asp-action="CreateRequest" class="btn btn-brand mt-2">+ Create Your First Request</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr class="text-uppercase text-muted small">
                                    <th>Blood Type</th>
                                    <th>Units</th>
                                    <th>Urgency</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model)
                                {
                                    <tr>
                                        <td><span class="fw-bold">🩸 @request.BloodType.Name</span></td>
                                        <td>@request.UnitsRequired <span class="text-muted small">units</span></td>
                                        <td>
                                            @if (request.Urgency == "Emergency")
                                            {
                                                <span class="badge rounded-pill" style="background:rgba(179,18,43,.1); color:var(--brand-red);">Emergency</span>
                                            }
                                            else if (request.Urgency == "Urgent")
                                            {
                                                <span class="badge rounded-pill bg-warning bg-opacity-25 text-warning-emphasis">Urgent</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-light text-dark">@request.Urgency</span>
                                            }
                                        </td>
                                        <td>
                                            @if (request.Status == "Fulfilled")
                                            {
                                                <span class="badge rounded-pill bg-success bg-opacity-25 text-success-emphasis">✔ Fulfilled</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-primary bg-opacity-25 text-primary-emphasis">@request.Status</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="ViewResponses" asp-route-id="@request.Id" class="text-decoration-none small fw-semibold">
                                                View Responses →
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>