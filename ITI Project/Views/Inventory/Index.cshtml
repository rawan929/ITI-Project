@model ITI.BLL.ViewModel.InventoryVM
@using ITI.BLL.Constants

@{
    Layout = "_Layout";
    ViewData["Title"] = "Inventory";
}

@functions {
    static string BarClass(string level) => level switch
    {
        InventoryLevels.Good => "bg-emerald-500",
        InventoryLevels.Low => "bg-amber-500",
        _ => "bg-red-600"
    };

    static string TagClass(string level) => level switch
    {
        InventoryLevels.Good => "bg-emerald-50 text-emerald-600",
        InventoryLevels.Low => "bg-amber-50 text-amber-600",
        _ => "bg-red-50 text-red-600"
    };
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .bg-admin-dark {
        background-color: #0A1628;
    }

    .text-rose-brand {
        color: #C41230;
    }

    .bg-rose-brand {
        background-color: #C41230;
    }
</style>

<!-- Header -->
<div class="bg-admin-dark text-white -mx-4 sm:-mx-6 lg:-mx-8 -mt-4 px-6 sm:px-8 pt-8 pb-8 mb-8 rounded-b-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-rose-brand rounded-2xl flex items-center justify-center text-white shadow-lg shadow-rose-900/40">
                <i class="fa-solid fa-warehouse text-xl"></i>
            </div>
            <div>
                <p class="text-xs text-slate-400 font-medium">Inventory Management</p>
                <h1 class="text-2xl font-bold tracking-tight font-serif">@Model.BloodBankName <span class="text-rose-brand">Inventory</span></h1>
            </div>
        </div>
        @if (Model.CriticalTypes > 0)
        {
            <span class="px-4 py-2 rounded-full text-xs font-semibold bg-red-950 text-red-300 border border-red-900">
                @Model.CriticalTypes Critical Alerts
            </span>
        }
    </div>
</div>

<div class="max-w-7xl mx-auto">
    <!-- Summary -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
            <p class="text-xs uppercase font-bold text-slate-400 tracking-wide">Total Units</p>
            <p class="text-4xl font-bold font-serif text-slate-900 mt-2">@Model.TotalUnits</p>
            <p class="text-sm text-slate-400 mt-1">Across all types</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
            <p class="text-xs uppercase font-bold text-slate-400 tracking-wide">Critical Types</p>
            <p class="text-4xl font-bold font-serif text-red-600 mt-2">@Model.CriticalTypes</p>
            <p class="text-sm text-slate-400 mt-1">Below safe threshold</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
            <p class="text-xs uppercase font-bold text-slate-400 tracking-wide">Good Stock</p>
            <p class="text-4xl font-bold font-serif text-emerald-600 mt-2">@Model.GoodTypes</p>
            <p class="text-sm text-slate-400 mt-1">Above @InventoryRules.GoodFromPercent% capacity</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
            <p class="text-xs uppercase font-bold text-slate-400 tracking-wide">Blood Types</p>
            <p class="text-4xl font-bold font-serif text-slate-900 mt-2">@Model.TrackedTypes</p>
            <p class="text-sm text-slate-400 mt-1">All types tracked</p>
        </div>
    </div>

    <!-- By type -->
    <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm">
        <h2 class="text-lg font-bold font-serif text-slate-900 mb-2">Blood Inventory by Type</h2>
        <div class="divide-y divide-slate-100">
            @foreach (var item in Model.Items)
            {
                <div class="flex items-center gap-6 py-5">
                    <div class="w-16 text-2xl font-bold font-serif text-rose-brand">@item.BloodTypeName</div>
                    <div class="flex-1">
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-semibold text-slate-900">@item.UnitsAvailable units</span>
                            <span class="text-xs font-semibold px-2.5 py-1 rounded-full @TagClass(item.Level)">@(item.Percent)% · @item.Level</span>
                        </div>
                        <div class="h-2.5 rounded-full bg-slate-100 overflow-hidden">
                            <div class="h-full rounded-full @BarClass(item.Level)" style="width: @(Math.Min(100, item.Percent))%"></div>
                        </div>
                        <p class="text-xs text-slate-400 mt-1">Capacity: @item.Capacity units</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>