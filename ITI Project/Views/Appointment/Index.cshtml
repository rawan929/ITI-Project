@model IEnumerable<ITI.BLL.ViewModel.AppointmentVM>
@using ITI.BLL.Constants
@{
    Layout = "_Layout";
    ViewData["Title"] = "Appointments";
}
@{
    var dateValue = ((DateTime)ViewBag.Date).ToString("yyyy-MM-dd");
}

@functions {
    static string BadgeClass(string status) => status switch
    {
        AppointmentStatuses.Scheduled => "bg-amber-50 text-amber-600 border-amber-200",
        AppointmentStatuses.Confirmed => "bg-emerald-50 text-emerald-600 border-emerald-200",
        AppointmentStatuses.Completed => "bg-sky-50 text-sky-600 border-sky-200",
        _ => "bg-slate-100 text-slate-500 border-slate-200"
    };

    static (string Status, string Label)[] ActionsFor(string status) => status switch
    {
        AppointmentStatuses.Scheduled => new[] { (AppointmentStatuses.Confirmed, "Confirm"), (AppointmentStatuses.Cancelled, "Cancel") },
        AppointmentStatuses.Confirmed => new[] { (AppointmentStatuses.Completed, "Complete"), (AppointmentStatuses.NoShow, "No Show"), (AppointmentStatuses.Cancelled, "Cancel") },
        _ => Array.Empty<(string, string)>()
    };
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .bg-admin-dark {
        background-color: #0A1628;
    }

    .text-rose-brand {
        color: #C41230;
    }

    .bg-rose-brand {
        background-color: #C41230;
    }
</style>

<!-- Header -->
<div class="bg-admin-dark text-white -mx-4 sm:-mx-6 lg:-mx-8 -mt-4 px-6 sm:px-8 pt-8 pb-8 mb-8 rounded-b-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-rose-brand rounded-2xl flex items-center justify-center text-white shadow-lg shadow-rose-900/40">
                <i class="fa-solid fa-calendar-check text-xl"></i>
            </div>
            <div>
                <p class="text-xs text-slate-400 font-medium">Appointments Management</p>
                <h1 class="text-2xl font-bold tracking-tight font-serif">Scheduled <span class="text-rose-brand">Appointments</span></h1>
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto">
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="mb-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-600 text-sm font-medium">@errorMessage</div>
    }

    <div class="flex items-center justify-between mb-4">
        <form method="get" asp-action="Index" class="flex items-center gap-3">
            <input type="hidden" name="bloodBankId" value="@ViewBag.BloodBankId" />
            <input type="date" name="date" value="@dateValue" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-800" />
            <button type="submit" class="px-4 py-2 bg-slate-100 text-slate-600 font-semibold rounded-xl hover:bg-slate-200 transition">Show</button>
        </form>
        <span class="text-sm font-semibold text-rose-brand">@(Model?.Count() ?? 0) appointments</span>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 border-b border-slate-200 text-xs font-bold uppercase text-slate-400">
                    <tr>
                        <th class="px-6 py-4">Time</th>
                        <th class="px-6 py-4">Donor</th>
                        <th class="px-6 py-4">Blood Type</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/50 transition">
                                <td class="px-6 py-4">@item.AppointmentDate.ToString("hh:mm tt")</td>
                                <td class="px-6 py-4 font-semibold text-slate-900">@(string.IsNullOrEmpty(item.DonorName) ? "N/A" : item.DonorName)</td>
                                <td class="px-6 py-4">@(item.BloodType ?? "-")</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border @BadgeClass(item.Status)">
                                        @AppointmentStatuses.Display(item.Status)
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex gap-2">
                                        @foreach (var action in ActionsFor(item.Status))
                                        {
                                            <form asp-action="ChangeStatus" method="post">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="bloodBankId" value="@ViewBag.BloodBankId" />
                                                <input type="hidden" name="status" value="@action.Status" />
                                                <input type="hidden" name="date" value="@dateValue" />
                                                <button type="submit"
                                                        class="px-3 py-1 border rounded-lg text-xs font-semibold @(action.Status == AppointmentStatuses.Confirmed || action.Status == AppointmentStatuses.Completed ? "border-rose-300 text-rose-700" : "border-slate-300 text-slate-500")">
                                                    @action.Label
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-slate-400 font-medium">No appointments for this day.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>